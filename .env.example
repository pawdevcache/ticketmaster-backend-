# Copy to .env and adjust. Loaded automatically on startup.
PORT=8080
ENV=development

# MongoDB connection
MONGO_URI=mongodb://localhost:27017
DB_NAME=ticketmaster

# Shared secret required to create an admin account via POST /api/admin/register
# (sent as the X-Admin-Key header). Admin registration is disabled while unset.
ADMIN_REGISTRATION_KEY=

# Payments. "off" (the default) confirms a booking on creation, as the service
# did before payments existed. "test" holds seats and requires a payment step
# with intents that always succeed — for local work only. "stripe" takes real
# money and needs STRIPE_SECRET_KEY. BOOKING_HOLD is how long an unpaid booking
# keeps its seats before they go back on sale.
PAYMENTS=off
STRIPE_SECRET_KEY=
PAYMENT_CURRENCY=usd
BOOKING_HOLD=15m

# Email delivery for password resets and booking confirmations. Leave SMTP_HOST
# empty and messages are written to the log instead of sent, which is what local
# development uses. SMTP_TLS is "starttls" (port 587) or "implicit" (port 465).
# APP_URL is your front end's address, used to build the reset link.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
SMTP_TLS=starttls
APP_URL=http://localhost:5173

# Rate limiting on login, registration and password recovery, per caller IP per
# endpoint. Set ATTEMPTS to 0 to disable. Defaults: 10 attempts per 15m.
RATE_LIMIT_ATTEMPTS=10
RATE_LIMIT_WINDOW=15m

# Optional bootstrap admin, created on startup if the email isn't registered yet.
# Lets you sign in before any admin exists; leave blank to skip seeding.
ADMIN_NAME=Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
