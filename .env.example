# Copy to .env and adjust. Loaded automatically on startup.
PORT=8080
ENV=development

# MongoDB connection
MONGO_URI=mongodb://localhost:27017
DB_NAME=ticketmaster

# Shared secret required to create an admin account via POST /api/admin/register
# (sent as the X-Admin-Key header). Admin registration is disabled while unset.
ADMIN_REGISTRATION_KEY=

# Optional bootstrap admin, created on startup if the email isn't registered yet.
# Lets you sign in before any admin exists; leave blank to skip seeding.
ADMIN_NAME=Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
